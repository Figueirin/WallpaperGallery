# Steam Web API Configuration for WallpaperGallery Catalog Sync
# Obtenha sua chave de API em: https://steamcommunity.com/dev/apikey
# Guia passo a passo completo: consulte o arquivo docs/STEAM_API_SETUP.md
# O Wallpaper Engine possui AppID 431960.

STEAM_API_KEY=your_steam_api_key_here

# Execução do script:
# Modo real exige autorização explícita; consulte docs/STEAM_API_SETUP.md
# Modo offline/mock (não requer chave): npm run sync:workshop -- --mock-export

# =========================================================================
# Firebase Cloud Firestore Configuration (Plano Spark Gratuito)
# =========================================================================

# Provedor explícito: 'mock', 'catalog' ou 'firestore'
VITE_DATA_PROVIDER=mock

# Credenciais públicas do cliente Web (Firebase Console -> Configurações do Projeto)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Credenciais privadas do Admin SDK (Apenas para o script de sincronização no backend)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json


